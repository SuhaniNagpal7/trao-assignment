APP_ENV=development
PORT=8011
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=ahead
ALLOWED_ORIGINS=http://localhost:3000
# Free Gemini API key from https://aistudio.google.com/apikey (no card required).
GEMINI_API_KEY=
# A pinned model id. Avoid the *-latest aliases: they track the newest model,
# whose free tier is only ~20 requests/day. gemini-3.5-flash-lite gives the
# most free headroom (~15 RPM); gemini-3.5-flash also works (~5 RPM).
GEMINI_MODEL=gemini-3.5-flash-lite
# Set these to the active free-tier quota shown in Google AI Studio.
GEMINI_RPM=15
GEMINI_TPM=250000
JOB_TIMEOUT_SECONDS=600
# Optional free-tier search and resource enrichment:
TAVILY_API_KEY=
YOUTUBE_API_KEY=
